# ══════════════════════════════════════════════════════════════
#  DIGITRANS-CM — Variables d'environnement PRODUCTION
#  ⚠ Toutes les valeurs sont injectées via AWS Secrets Manager
#  ⚠ Ne jamais stocker de vraies valeurs dans ce fichier
# ══════════════════════════════════════════════════════════════

NODE_ENV=production

# Injecté par AWS ECS Task Definition / Secrets Manager
DB_USER=<injecté_par_secrets_manager>
DB_PASSWORD=<injecté_par_secrets_manager>
DB_NAME=digitrans_prod
DB_HOST=<rds_endpoint_prod>
DB_PORT=5432

REDIS_URL=<injecté_par_secrets_manager>
REDIS_PASSWORD=<injecté_par_secrets_manager>

JWT_SECRET=<injecté_par_secrets_manager>
JWT_EXPIRES_IN=4h
REFRESH_TOKEN_EXPIRES_IN=24h

AUTH_GATEWAY_URL=https://api.digitrans-cm.com
ERP_SERVICE_URL=http://erp-service.digitrans-internal:3001
CRM_SERVICE_URL=http://crm-service.digitrans-internal:3002
SUPPLY_CHAIN_SERVICE_URL=http://supply-chain.digitrans-internal:3003
BI_SERVICE_URL=http://bi-service.digitrans-internal:3004

AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=<injecté_par_iam_role>
AWS_SECRET_ACCESS_KEY=<injecté_par_iam_role>
S3_BUCKET_NAME=digitrans-prod-assets

AZURE_TENANT_ID=<injecté_par_secrets_manager>
AZURE_CLIENT_ID=<injecté_par_secrets_manager>
AZURE_CLIENT_SECRET=<injecté_par_secrets_manager>

SYNC_INTERVAL_MS=60000
OFFLINE_QUEUE_MAX_SIZE=10000

LOG_LEVEL=warn
LOG_FORMAT=json
