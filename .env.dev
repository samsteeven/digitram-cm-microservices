# ══════════════════════════════════════════════════════════════
#  DIGITRANS-CM — Variables d'environnement DÉVELOPPEMENT
#  NE JAMAIS COMMITER CE FICHIER EN PRODUCTION
# ══════════════════════════════════════════════════════════════

NODE_ENV=development

# ─── Base de données ─────────────────────────────────────────
DB_USER=digitrans
DB_PASSWORD=digitrans_dev_pwd
DB_NAME=digitrans
DB_HOST=localhost
DB_PORT=5432

# ─── Redis (cache + offline sync) ────────────────────────────
REDIS_URL=redis://:redis_dev_pwd@localhost:6379
REDIS_PASSWORD=redis_dev_pwd

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=dev_jwt_secret_change_me_in_prod_32chars_minimum
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── URLs des microservices ───────────────────────────────────
AUTH_GATEWAY_URL=http://localhost:3000
ERP_SERVICE_URL=http://localhost:3001
CRM_SERVICE_URL=http://localhost:3002
SUPPLY_CHAIN_SERVICE_URL=http://localhost:3003
BI_SERVICE_URL=http://localhost:3004

# ─── AWS (af-south-1 — Cape Town) ────────────────────────────
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_dev
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_dev
S3_BUCKET_NAME=digitrans-dev-assets

# ─── Azure (South Africa North) ──────────────────────────────
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_CLIENT_ID=your_azure_client_id
AZURE_CLIENT_SECRET=your_azure_client_secret

# ─── Supply Chain / Offline Sync ─────────────────────────────
SYNC_INTERVAL_MS=30000
OFFLINE_QUEUE_MAX_SIZE=1000

# ─── Logs ────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FORMAT=pretty
